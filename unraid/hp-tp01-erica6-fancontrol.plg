<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "hp-tp01-erica6-fancontrol">
<!ENTITY author "ederm42">
<!ENTITY version "1.0.0">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ederm42/hp-tp01-erica6-fancontrol/main/unraid/hp-tp01-erica6-fancontrol.plg">
<!ENTITY supportURL "https://github.com/ederm42/hp-tp01-erica6-fancontrol/issues">
<!ENTITY icon "hp-tp01-erica6-fancontrol.png">
<!ENTITY plugin "/boot/config/plugins/&name;">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="Settings/HPErica6FanControl" pluginURL="&pluginURL;" support="&supportURL;" icon="&icon;" min="6.12.0">

<CHANGES>
### &version;
- First clean release as hp-tp01-erica6-fancontrol.
- Confirmed mapping: pwm1/fan1 is rear SYS_FAN; pwm2/fan2 is CPU_FAN + splitter.
- Editable fan curves, Restore Defaults, disk temperature monitoring and fail-safe full speed.
</CHANGES>

<!-- Kernel driver dependency stays separate on purpose. -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
if ! modinfo it87 >/dev/null 2>&1; then
    echo ""
    echo "WARNING: it87 is not available yet."
    echo "Install 'ITE IT87 Driver' by ich777 from Community Applications."
    echo "The fan controller will stay stopped until the driver is available."
    echo ""
fi

for cmd in smartctl lsblk timeout; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "WARNING: missing required command: $cmd"
    fi
done
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
mkdir -p /usr/local/emhttp/plugins/hp-tp01-erica6-fancontrol
printf '%s' '' | base64 -d > /usr/local/emhttp/plugins/hp-tp01-erica6-fancontrol/hp-tp01-erica6-fancontrol.png
chmod 0644 /usr/local/emhttp/plugins/hp-tp01-erica6-fancontrol/hp-tp01-erica6-fancontrol.png
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/&name;">
<INLINE><![CDATA[
#!/bin/bash
set -u

NAME="hp-tp01-erica6-fancontrol"
CONFIG="${HP_TP01_ERICA6_FANCONTROL_CONFIG:-/etc/hp-tp01-erica6-fancontrol.conf}"
STATUS_FILE="${HP_TP01_ERICA6_FANCONTROL_STATUS:-/var/run/hp-tp01-erica6-fancontrol.status}"
DISK_SCAN_FILE="${HP_TP01_ERICA6_FANCONTROL_DISKS:-/var/run/hp-tp01-erica6-fancontrol.disks}"

# Defaults. A config file may override these.
LOOP_DELAY=0.5
DISK_POLL_SECONDS=30
DISK_CACHE_SECONDS=600
STATUS_SECONDS=30

# Confirmed TP01 mapping:
#   pwm1/fan1 = 3-pin rear SYS_FAN
#   pwm2/fan2 = 4-pin CPU_FAN + splitter
SYS_HEADER_CPU_CURVE="45:110 55:130 65:165 75:210 85:255"
SYS_HEADER_DISK_CURVE="30:110 35:125 38:145 41:170 44:200 47:230 50:255"
CPU_HEADER_CPU_CURVE="45:64 55:90 65:130 75:190 85:255"
CPU_HEADER_DISK_CURVE="30:64 35:90 38:120 41:160 44:200 47:235 50:255"
CPU_EMERGENCY_C=90
DISK_EMERGENCY_C=50

[[ -r "$CONFIG" ]] && source "$CONFIG"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

fail() {
    log "ERROR: $*"
    exit 1
}

max2() {
    (( $1 > $2 )) && echo "$1" || echo "$2"
}

clamp_pwm() {
    local v=$1
    (( v < 0 )) && v=0
    (( v > 255 )) && v=255
    echo "$v"
}

curve_value() {
    local temp=$1 curve=$2 pair t p prev_t="" prev_p=""

    for pair in $curve; do
        t=${pair%%:*}
        p=${pair##*:}
        [[ "$t" =~ ^[0-9]+$ && "$p" =~ ^[0-9]+$ ]] || continue

        if [[ -z "$prev_t" ]]; then
            if (( temp <= t )); then
                echo "$p"
                return
            fi
            prev_t=$t
            prev_p=$p
            continue
        fi

        if (( temp <= t )); then
            if (( t == prev_t )); then
                echo "$p"
            else
                echo $(( prev_p + (temp - prev_t) * (p - prev_p) / (t - prev_t) ))
            fi
            return
        fi

        prev_t=$t
        prev_p=$p
    done

    [[ -n "$prev_p" ]] && echo "$prev_p" || echo 255
}

find_hwmon() {
    local h
    for h in /sys/class/hwmon/hwmon*; do
        [[ -r "$h/name" ]] || continue
        [[ "$(cat "$h/name" 2>/dev/null)" == "it8628" ]] && { echo "$h"; return 0; }
    done
    return 1
}

ensure_it87() {
    local h
    h=$(find_hwmon || true)
    if [[ -n "$h" ]]; then
        echo "$h"
        return 0
    fi

    command -v modprobe >/dev/null 2>&1 || return 1
    modinfo it87 >/dev/null 2>&1 || return 1

    modprobe -r it87 2>/dev/null || true
    modprobe it87 force_id=0x8628 || return 1
    sleep 1
    find_hwmon
}

find_cpu_temp_file() {
    local h label f
    for h in /sys/class/hwmon/hwmon*; do
        [[ -r "$h/name" ]] || continue
        [[ "$(cat "$h/name" 2>/dev/null)" == "k10temp" ]] || continue

        for label in "$h"/temp*_label; do
            [[ -r "$label" ]] || continue
            if [[ "$(cat "$label" 2>/dev/null)" == "Tctl" ]]; then
                f=${label%_label}_input
                [[ -r "$f" ]] && { echo "$f"; return 0; }
            fi
        done

        [[ -r "$h/temp1_input" ]] && { echo "$h/temp1_input"; return 0; }
    done
    return 1
}

read_cpu_c() {
    local raw
    [[ -n "${CPU_TEMP_FILE:-}" && -r "$CPU_TEMP_FILE" ]] || return 1
    raw=$(cat "$CPU_TEMP_FILE" 2>/dev/null) || return 1
    [[ "$raw" =~ ^[0-9]+$ ]] || return 1
    (( raw >= 1000 && raw <= 120000 )) || return 1
    echo $(( raw / 1000 ))
}

smart_temp_c() {
    local dev=$1 out temp

    if [[ "$dev" == /dev/nvme* ]]; then
        out=$(timeout 4 smartctl -A "$dev" 2>/dev/null || true)
    else
        out=$(timeout 4 smartctl -n standby -A "$dev" 2>/dev/null || true)
    fi

    temp=$(awk '
      ($1==190 || $1==194) && $10 ~ /^[0-9]+$/ { print $10; exit }
      /^Temperature:/ {
        for (i=2;i<=NF;i++) if ($i ~ /^[0-9]+$/) { print $i; exit }
      }
      /Current Drive Temperature:/ {
        for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) { print $i; exit }
      }
      /^Temperature Sensor [0-9]+:/ {
        for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) { print $i; exit }
      }
    ' <<< "$out")

    [[ "$temp" =~ ^[0-9]+$ ]] && (( temp > 0 && temp < 100 )) || return 1
    echo "$temp"
}

scan_disks() {
    local tmp="${DISK_SCAN_FILE}.$$" dev type temp
    : > "$tmp"
    printf '#%s\n' "$(date +%s)" >> "$tmp"

    while read -r dev type; do
        [[ "$type" == "disk" && -n "$dev" ]] || continue
        if temp=$(smart_temp_c "/dev/$dev"); then
            printf '%s|%s\n' "/dev/$dev" "$temp" >> "$tmp"
        else
            printf '%s|\n' "/dev/$dev" >> "$tmp"
        fi
    done < <(lsblk -dn -o NAME,TYPE 2>/dev/null)

    mv -f "$tmp" "$DISK_SCAN_FILE"
}

command -v smartctl >/dev/null 2>&1 || fail "smartctl not found (install smartmontools)"
command -v lsblk >/dev/null 2>&1 || fail "lsblk not found"
command -v timeout >/dev/null 2>&1 || fail "timeout not found"

# Do not allow two controllers to fight each other.
if command -v flock >/dev/null 2>&1; then
    exec 9>/var/run/hp-tp01-erica6-fancontrol.lock
    flock -n 9 || fail "already running"
fi

H=$(ensure_it87 || true)
[[ -n "$H" ]] || fail "it87 driver not available or IT8628 compatibility interface did not appear"

for f in pwm1 pwm2 pwm1_enable pwm2_enable fan1_input fan2_input; do
    [[ -e "$H/$f" ]] || fail "$H/$f is missing"
done

CPU_TEMP_FILE=$(find_cpu_temp_file || true)
[[ -n "$CPU_TEMP_FILE" ]] || log "WARNING: k10temp/Tctl not found; fail-safe will run both headers at full speed"

mkdir -p "$(dirname "$STATUS_FILE")" "$(dirname "$DISK_SCAN_FILE")"
rm -f "$STATUS_FILE" "$DISK_SCAN_FILE"

DISK_SCAN_PID=""
cleanup() {
    trap - EXIT INT TERM
    [[ -n "$DISK_SCAN_PID" ]] && kill "$DISK_SCAN_PID" 2>/dev/null || true
    # Leave cooling high while HP firmware takes control back.
    echo 1 > "$H/pwm1_enable" 2>/dev/null || true
    echo 1 > "$H/pwm2_enable" 2>/dev/null || true
    echo 255 > "$H/pwm1" 2>/dev/null || true
    echo 255 > "$H/pwm2" 2>/dev/null || true
    rm -f "$STATUS_FILE"
    log "stopped; set both headers to 255 and released control"
}
trap cleanup EXIT
trap 'exit 0' INT TERM

declare -A LAST_TEMP
declare -A LAST_SEEN
DISKS=()
LAST_SCAN_STAMP=""
LAST_SCAN_START=0
LAST_STATUS=0
DISK_READY=0

start_disk_scan() {
    scan_disks &
    DISK_SCAN_PID=$!
    LAST_SCAN_START=$(date +%s)
}

load_disk_scan() {
    local stamp line dev temp now
    [[ -r "$DISK_SCAN_FILE" ]] || return 0
    stamp=$(head -n1 "$DISK_SCAN_FILE" 2>/dev/null)
    [[ -n "$stamp" && "$stamp" != "$LAST_SCAN_STAMP" ]] || return 0

    LAST_SCAN_STAMP=$stamp
    now=$(date +%s)
    DISKS=()

    while IFS='|' read -r dev temp; do
        [[ "$dev" == /dev/* ]] || continue
        DISKS+=("$dev")
        if [[ "$temp" =~ ^[0-9]+$ ]] && (( temp > 0 && temp < 100 )); then
            LAST_TEMP["$dev"]=$temp
            LAST_SEEN["$dev"]=$now
        fi
    done < <(tail -n +2 "$DISK_SCAN_FILE")

    DISK_READY=1
}

start_disk_scan
log "started: $H, CPU sensor=${CPU_TEMP_FILE:-missing}"
log "pwm1/fan1 = 3-pin rear/SYS header; pwm2/fan2 = 4-pin CPU header + splitter"

while true; do
    now=$(date +%s)

    if [[ -n "$DISK_SCAN_PID" ]] && ! kill -0 "$DISK_SCAN_PID" 2>/dev/null; then
        wait "$DISK_SCAN_PID" 2>/dev/null || true
        DISK_SCAN_PID=""
    fi
    load_disk_scan

    if [[ -z "$DISK_SCAN_PID" ]] && (( now - LAST_SCAN_START >= DISK_POLL_SECONDS )); then
        start_disk_scan
    fi

    if CPU_C=$(read_cpu_c); then
        CPU_OK=1
    else
        CPU_OK=0
        CPU_C=-1
    fi

    HOT_DISK_C=-1
    HOT_DISK="none"
    DISK_SUMMARY=""

    for dev in "${DISKS[@]}"; do
        if [[ -n "${LAST_TEMP[$dev]:-}" && -n "${LAST_SEEN[$dev]:-}" ]]; then
            age=$(( now - LAST_SEEN[$dev] ))
            if (( age <= DISK_CACHE_SECONDS )); then
                temp=${LAST_TEMP[$dev]}
                if (( temp > HOT_DISK_C )); then
                    HOT_DISK_C=$temp
                    HOT_DISK=$dev
                fi
                if (( age > DISK_POLL_SECONDS + 5 )); then
                    DISK_SUMMARY+="$dev=${temp}C~ "
                else
                    DISK_SUMMARY+="$dev=${temp}C "
                fi
                continue
            fi
        fi
        DISK_SUMMARY+="$dev=sleep/unknown "
    done

    if (( CPU_OK )); then
        CPU_TO_CPU=$(curve_value "$CPU_C" "$CPU_HEADER_CPU_CURVE")
        CPU_TO_SYS=$(curve_value "$CPU_C" "$SYS_HEADER_CPU_CURVE")
    else
        CPU_TO_CPU=255
        CPU_TO_SYS=255
    fi

    if (( HOT_DISK_C >= 0 )); then
        DISK_TO_CPU=$(curve_value "$HOT_DISK_C" "$CPU_HEADER_DISK_CURVE")
        DISK_TO_SYS=$(curve_value "$HOT_DISK_C" "$SYS_HEADER_DISK_CURVE")
    elif (( DISK_READY )); then
        # No readable/cached temperature usually means the disks are asleep.
        DISK_TO_CPU=$(curve_value 0 "$CPU_HEADER_DISK_CURVE")
        DISK_TO_SYS=$(curve_value 0 "$SYS_HEADER_DISK_CURVE")
    else
        # At startup, cool hard until the first all-disk scan finishes.
        DISK_TO_CPU=255
        DISK_TO_SYS=255
    fi

    # Physical mapping confirmed by manual fan testing.
    PWM1=$(clamp_pwm "$(max2 "$CPU_TO_SYS" "$DISK_TO_SYS")")
    PWM2=$(clamp_pwm "$(max2 "$CPU_TO_CPU" "$DISK_TO_CPU")")

    if (( ! CPU_OK )); then
        PWM1=255
        PWM2=255
    fi
    if (( CPU_OK && CPU_C >= CPU_EMERGENCY_C )); then
        PWM1=255
        PWM2=255
    fi
    if (( HOT_DISK_C >= DISK_EMERGENCY_C )); then
        PWM1=255
        PWM2=255
    fi

    # HP firmware rewrites these values after roughly 1-2 seconds.
    # Reassert every loop.
    echo 1 > "$H/pwm1_enable"
    echo 1 > "$H/pwm2_enable"
    echo "$PWM1" > "$H/pwm1"
    echo "$PWM2" > "$H/pwm2"

    if (( now - LAST_STATUS >= STATUS_SECONDS )); then
        LAST_STATUS=$now
        FAN1=$(cat "$H/fan1_input" 2>/dev/null || echo '?')
        FAN2=$(cat "$H/fan2_input" 2>/dev/null || echo '?')
        (( CPU_OK )) && CPU_TEXT="${CPU_C}C" || CPU_TEXT="FAIL"
        (( HOT_DISK_C >= 0 )) && HOT_TEXT="${HOT_DISK}=${HOT_DISK_C}C" || HOT_TEXT="none"

        LINE="CPU=$CPU_TEXT HOT=$HOT_TEXT | SYS_HEADER=$PWM1 FAN1=${FAN1}rpm | CPU_HEADER=$PWM2 FAN2=${FAN2}rpm"
        {
            echo "$LINE"
            echo "disks: ${DISK_SUMMARY:-none}"
        } > "$STATUS_FILE"
        log "$LINE"
        log "disks: ${DISK_SUMMARY:-none}"
    fi

    sleep "$LOOP_DELAY"
done
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/default.conf">
<INLINE><![CDATA[
# HP TP01 Erica6 fan control
# Curves are tempC:control pairs. Values between points are interpolated.
# Confirmed mapping: pwm1/fan1 = rear SYS_FAN, pwm2/fan2 = CPU_FAN.
LOOP_DELAY=0.5
DISK_POLL_SECONDS=30
DISK_CACHE_SECONDS=600
STATUS_SECONDS=30

# 3-pin rear/SYS header (Linux: pwm1 / fan1)
SYS_HEADER_CPU_CURVE="45:110 55:130 65:165 75:210 85:255"
SYS_HEADER_DISK_CURVE="30:110 35:125 38:145 41:170 44:200 47:230 50:255"

# 4-pin CPU header + splitter (Linux: pwm2 / fan2)
CPU_HEADER_CPU_CURVE="45:64 55:90 65:130 75:190 85:255"
CPU_HEADER_DISK_CURVE="30:64 35:90 38:120 41:160 44:200 47:235 50:255"

CPU_EMERGENCY_C=90
DISK_EMERGENCY_C=50
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/HPErica6FanControl.page">
<INLINE><![CDATA[
Menu="OtherSettings"
Title="HP TP01 Erica6 Fan Control"
Icon="hp-tp01-erica6-fancontrol.png"
Author="ederm42"
---
<?php
$name = 'hp-tp01-erica6-fancontrol';
$uiVersion = '1.0.0';
$configFile = "/boot/config/plugins/$name/$name.conf";
$defaultFile = "/usr/local/emhttp/plugins/$name/default.conf";
$statusFile = "/var/run/$name.status";
$logFile = "/var/log/$name.log";
$pidFile = "/var/run/$name.pid";
$rc = "/etc/rc.d/rc.$name";

$defaults = [
    'LOOP_DELAY' => '0.5',
    'DISK_POLL_SECONDS' => '30',
    'DISK_CACHE_SECONDS' => '600',
    'STATUS_SECONDS' => '30',
    'SYS_HEADER_CPU_CURVE' => '45:110 55:130 65:165 75:210 85:255',
    'SYS_HEADER_DISK_CURVE' => '30:110 35:125 38:145 41:170 44:200 47:230 50:255',
    'CPU_HEADER_CPU_CURVE' => '45:64 55:90 65:130 75:190 85:255',
    'CPU_HEADER_DISK_CURVE' => '30:64 35:90 38:120 41:160 44:200 47:235 50:255',
    'CPU_EMERGENCY_C' => '90',
    'DISK_EMERGENCY_C' => '50',
];

function h($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function readConfig($path, $defaults) {
    $cfg = $defaults;
    if (!is_readable($path)) return $cfg;

    foreach (file($path, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') continue;
        if (!preg_match('/^([A-Z0-9_]+)=(.*)$/', $line, $m)) continue;
        $value = trim($m[2]);
        if (strlen($value) >= 2 && (($value[0] === '"' && substr($value, -1) === '"') || ($value[0] === "'" && substr($value, -1) === "'"))) {
            $value = substr($value, 1, -1);
        }
        $cfg[$m[1]] = $value;
    }
    return $cfg;
}

function curvePoints($curve) {
    $points = [];
    foreach (preg_split('/\s+/', trim($curve)) as $pair) {
        if (preg_match('/^(\d+):(\d+)$/', $pair, $m)) {
            $points[] = [(int)$m[1], (int)$m[2]];
        }
    }
    return $points;
}

function postedCurve($tempKey, $controlKey, &$errors, $label) {
    $temps = $_POST[$tempKey] ?? [];
    $controls = $_POST[$controlKey] ?? [];
    if (!is_array($temps) || !is_array($controls) || count($temps) !== count($controls) || count($temps) < 2 || count($temps) > 12) {
        $errors[] = "$label must have 2-12 points.";
        return null;
    }

    $out = [];
    $lastTemp = -1;
    foreach ($temps as $i => $tempRaw) {
        $controlRaw = $controls[$i] ?? '';
        if (!preg_match('/^\d+$/', (string)$tempRaw) || !preg_match('/^\d+$/', (string)$controlRaw)) {
            $errors[] = "$label contains a non-numeric value.";
            return null;
        }
        $temp = (int)$tempRaw;
        $control = (int)$controlRaw;
        if ($temp < 0 || $temp > 120 || $control < 0 || $control > 255) {
            $errors[] = "$label values must be 0-120 C and 0-255 control.";
            return null;
        }
        if ($temp <= $lastTemp) {
            $errors[] = "$label temperatures must increase from top to bottom.";
            return null;
        }
        $lastTemp = $temp;
        $out[] = "$temp:$control";
    }
    return implode(' ', $out);
}

function postedInt($key, $min, $max, &$errors, $label) {
    $raw = $_POST[$key] ?? '';
    if (!preg_match('/^\d+$/', (string)$raw)) {
        $errors[] = "$label must be a whole number.";
        return null;
    }
    $value = (int)$raw;
    if ($value < $min || $value > $max) {
        $errors[] = "$label must be between $min and $max.";
        return null;
    }
    return $value;
}

function copyFileAtomic($src, $dst) {
    if (!is_readable($src)) return false;
    $dir = dirname($dst);
    if (!is_dir($dir) && !mkdir($dir, 0755, true)) return false;
    $tmp = tempnam($dir, '.fanctl.');
    if ($tmp === false) return false;
    $data = file_get_contents($src);
    $ok = $data !== false && file_put_contents($tmp, $data, LOCK_EX) !== false && rename($tmp, $dst);
    if (!$ok) @unlink($tmp);
    return $ok;
}

function writeConfig($path, $cfg) {
    $text = "# HP TP01 fan control\n";
    $text .= "# Curves are tempC:control pairs. Values between points are interpolated.\n";
    $text .= "# Confirmed mapping: pwm1/fan1 = rear SYS_FAN, pwm2/fan2 = CPU_FAN.\n\n";
    $text .= "LOOP_DELAY=0.5\n";
    $text .= "DISK_POLL_SECONDS=30\n";
    $text .= "DISK_CACHE_SECONDS=600\n";
    $text .= "STATUS_SECONDS=30\n\n";
    $text .= "# 3-pin rear/SYS header (Linux: pwm1 / fan1)\n";
    $text .= 'SYS_HEADER_CPU_CURVE="'.$cfg['SYS_HEADER_CPU_CURVE']."\"\n";
    $text .= 'SYS_HEADER_DISK_CURVE="'.$cfg['SYS_HEADER_DISK_CURVE']."\"\n\n";
    $text .= "# 4-pin CPU header + splitter (Linux: pwm2 / fan2)\n";
    $text .= 'CPU_HEADER_CPU_CURVE="'.$cfg['CPU_HEADER_CPU_CURVE']."\"\n";
    $text .= 'CPU_HEADER_DISK_CURVE="'.$cfg['CPU_HEADER_DISK_CURVE']."\"\n\n";
    $text .= 'CPU_EMERGENCY_C='.$cfg['CPU_EMERGENCY_C']."\n";
    $text .= 'DISK_EMERGENCY_C='.$cfg['DISK_EMERGENCY_C']."\n";

    $dir = dirname($path);
    if (!is_dir($dir) && !mkdir($dir, 0755, true)) return false;
    $tmp = tempnam($dir, '.fanctl.');
    if ($tmp === false) return false;
    $ok = file_put_contents($tmp, $text, LOCK_EX) !== false && rename($tmp, $path);
    if (!$ok) @unlink($tmp);
    return $ok;
}

$cfg = readConfig($configFile, readConfig($defaultFile, $defaults));
$message = '';
$messageClass = 'notice';
$errors = [];

if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
    $action = $_POST['action'] ?? '';

    if ($action === 'restore') {
        if (copyFileAtomic($defaultFile, $configFile)) {
            $cfg = readConfig($configFile, $defaults);
            $out = [];
            $code = 0;
            exec($rc.' restart 2>&1', $out, $code);
            if ($code === 0) {
                $message = 'Defaults restored. Fan controller restarted.';
            } else {
                $message = 'Defaults restored, but restart failed. Check the log below.';
                $messageClass = 'warning';
            }
        } else {
            $errors[] = 'Could not restore the shipped default config.';
        }
    } elseif ($action === 'save') {
        $new = $cfg;
        $new['CPU_HEADER_CPU_CURVE'] = postedCurve('cpu_cpu_temp', 'cpu_cpu_control', $errors, 'CPU -> CPU header');
        $new['CPU_HEADER_DISK_CURVE'] = postedCurve('disk_cpu_temp', 'disk_cpu_control', $errors, 'Disk -> CPU header');
        $new['SYS_HEADER_DISK_CURVE'] = postedCurve('disk_sys_temp', 'disk_sys_control', $errors, 'Disk -> rear/SYS header');
        $new['SYS_HEADER_CPU_CURVE'] = postedCurve('cpu_sys_temp', 'cpu_sys_control', $errors, 'CPU -> rear/SYS header');
        $new['CPU_EMERGENCY_C'] = postedInt('CPU_EMERGENCY_C', 50, 110, $errors, 'CPU emergency temperature');
        $new['DISK_EMERGENCY_C'] = postedInt('DISK_EMERGENCY_C', 30, 80, $errors, 'Disk emergency temperature');

        if (!$errors && writeConfig($configFile, $new)) {
            $cfg = $new;
            $out = [];
            $code = 0;
            exec($rc.' restart 2>&1', $out, $code);
            if ($code === 0) {
                $message = 'Saved. Fan controller restarted with the new curves.';
            } else {
                $message = 'Saved, but restart failed. Check the log below.';
                $messageClass = 'warning';
            }
        } elseif (!$errors) {
            $errors[] = 'Could not write the config file.';
        }
    }
}

$running = false;
if (is_readable($pidFile)) {
    $pid = trim(file_get_contents($pidFile));
    $running = ctype_digit($pid) && is_dir('/proc/'.$pid);
}
$status = is_readable($statusFile) ? trim(file_get_contents($statusFile)) : 'No status yet.';
$log = is_readable($logFile) ? implode("\n", array_slice(file($logFile, FILE_IGNORE_NEW_LINES) ?: [], -24)) : 'No log yet.';

function curveTable($title, $help, $curve, $tempName, $controlName) {
    $points = curvePoints($curve);
    echo '<div class="fanctl-curve" data-curve>';
    echo '<div class="fanctl-curve-title"><div><h4>'.h($title).'</h4><p>'.h($help).'</p></div><button type="button" class="fanctl-add">Add point</button></div>';
    echo '<table><thead><tr><th>Temp °C</th><th>Control 0-255</th><th></th></tr></thead><tbody>';
    foreach ($points as $point) {
        echo '<tr>';
        echo '<td><input type="number" min="0" max="120" step="1" name="'.h($tempName).'[]" value="'.h($point[0]).'" required></td>';
        echo '<td><input type="number" min="0" max="255" step="1" name="'.h($controlName).'[]" value="'.h($point[1]).'" required></td>';
        echo '<td><button type="button" class="fanctl-remove" title="Remove point">Remove</button></td>';
        echo '</tr>';
    }
    echo '</tbody></table>';
    echo '</div>';
}
?>

<style>
#fanctl { max-width: 1180px; }
#fanctl .fanctl-top { display:flex; align-items:center; gap:14px; margin:0 0 18px; }
#fanctl .fanctl-icon { width:52px; height:52px; object-fit:contain; flex:0 0 auto; }
#fanctl .fanctl-top h2 { margin:0 0 3px; }
#fanctl .fanctl-top p { margin:0; opacity:.75; }
